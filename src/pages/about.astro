---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PointPortrait from "../components/PointPortrait.astro";
import { Github, Linkedin, Satellite, Mail } from "lucide-astro";
import PubList from "../components/PubList.astro";
import { PROFILE, EDUCATION, EXPERIENCE, PUBLICATIONS, AWARDS, TRAINING } from "../data/profile";

// Facts live in src/data/profile.ts; this page only lays them out.

const DESCRIPTION =
  "About Kristie Hu: PhD student at the University of Waterloo (GIM Lab) working on Earth-observation foundation models, LiDAR point clouds and production geospatial data systems.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="About" description={DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main class="about">
      <!-- HERO -->
      <section class="hero">
        <PointPortrait width={120} />

        <div class="heroText">
          <p class="kicker">About</p>
          <h1 class="page-title name">
            {PROFILE.name} <span class="zh">{PROFILE.nameZh}</span>
          </h1>
          <p class="pronounce">{PROFILE.pronounce}</p>
          <ul class="identity">
            {
              PROFILE.identity.map((x) => (
                <li>{x.role}&nbsp;<span class="sep">·</span> <a href={x.href} target="_blank" rel="noopener noreferrer">{x.org}</a></li>
              ))
            }
          </ul>

          <nav class="social" aria-label="External links">
            <a href={PROFILE.links.github} target="_blank" rel="noopener noreferrer" class="icon-link">
              <Github size={24} />
              <span class="tooltip">GitHub</span>
            </a>
            <a href={PROFILE.links.linkedin} target="_blank" rel="noopener noreferrer" class="icon-link">
              <Linkedin size={24} />
              <span class="tooltip">LinkedIn</span>
            </a>
            <a href={PROFILE.links.lab} target="_blank" rel="noopener noreferrer" class="icon-link">
              <Satellite size={24} />
              <span class="tooltip">GIM Lab</span>
            </a>
            <a href={PROFILE.links.email} class="icon-link">
              <Mail size={24} />
              <span class="tooltip">Email</span>
            </a>
          </nav>
        </div>
      </section>

      <!-- BIO -->
      <section class="bio">
        <p>
          I’m a PhD student in Civil and Environmental Engineering at the University of Waterloo, working in the
          <a href="https://uwaterloo.ca/geospatial-intelligence/">Geospatial Intelligence and Mapping (GIM) Lab</a>.
          I study what Earth-observation foundation models learn from satellite data and how well that knowledge
          carries over to new regions and sensors, especially when few labels are available. I also explore how
          spectral and 3D data can work together beyond simply stacking their features. Much of this work involves
          close collaboration with
          <a href="https://research.aalto.fi/en/persons/kyle-gao/">Dr. Kyle Gao</a> at Aalto University and the TESSERA team at the University of
          Cambridge, and runs on computing resources from
          <a href="https://csc.fi/en/">CSC</a>, the Finnish IT Center for Science.
        </p>
        <p>
          These questions grew out of projects that kept running into messy data: modelling a GNSS-denied parking garage
          from handheld LiDAR for my MSc, mapping crops with PRISMA hyperspectral imagery and detecting Arctic seals at the
          <a href="https://vip.uwaterloo.ca/">Vision and Image Processing Lab</a>, and measuring methane plumes over a
          mountain coal mine.
        </p>
        <p>
          Alongside research, I work full-time at Beanfield Metroconnect, building the automated geospatial pipelines and
          internal tools behind a Toronto fibre network: 450+ files a month, with capacity reporting time cut by 75%. That
          job keeps my research honest. I care most about methods that are not only new but robust, repeatable and useful
          at scale. <a href="/blog">See the work<span class="arr" aria-hidden="true">→</span></a>
        </p>
      </section>

      <!-- EDUCATION -->
      <section class="block" id="education">
        <h2 class="section-title">Education</h2>
        <ul class="cv">
          {
            EDUCATION.map((e) => (
              <li>
                <div class="cv-main">
                  <span class="cv-title">{e.title}</span>
                  <span class="cv-org">{e.org}</span>
                  {e.note && (
                    <span class="cv-note">
                      {e.href ? <a href={e.href} target="_blank" rel="noopener noreferrer">{e.note}</a> : e.note}
                    </span>
                  )}
                </div>
                <span class="cv-dates">{e.dates}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- EXPERIENCE -->
      <section class="block" id="experience">
        <h2 class="section-title">Experience</h2>
        <ul class="cv">
          {
            EXPERIENCE.map((e) => (
              <li>
                <div class="cv-main">
                  <span class="cv-title">{e.title}</span>
                  <span class="cv-org">{e.org}</span>
                  {e.note && <span class="cv-note">{e.note}</span>}
                </div>
                <span class="cv-dates">{e.dates}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- PUBLICATIONS -->
      <section class="block" id="publications">
        <h2 class="section-title">Publications</h2>
        {
          PUBLICATIONS.map((g) => (
            <div class="pub-group">
              <h3>{g.group}</h3>
              <PubList items={g.items} />
            </div>
          ))
        }
      </section>

      <!-- AWARDS + TRAINING -->
      <section class="block two-col">
        <div>
          <h2 class="section-title">Awards</h2>
          <ul class="simple">
            {AWARDS.map((a) => <li><span>{a.title}</span><span class="cv-dates">{a.dates}</span></li>)}
          </ul>
        </div>
        <div>
          <h2 class="section-title">Training &amp; certifications</h2>
          <ul class="simple">
            {
              TRAINING.map((t) => (
                <li>
                  <span>
                    {t.href ? <a href={t.href} target="_blank" rel="noopener noreferrer">{t.title}</a> : t.title}
                    <span class="cv-org"> · {t.org}</span>
                  </span>
                  <span class="cv-dates">{t.dates}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <p class="more">
        Leadership, service and teaching are on <a href="/teaching">Teaching &amp; Service</a>.
      </p>
      <p class="motto">{PROFILE.motto}</p>
    </main>

    <Footer />

    <style>
      .about {
        display: block;
        box-sizing: border-box; /* the global main rule adds padding to a 100% width */
        --col: 760px;
      }

      /* ===== Hero ===== */
      /* name: the shared page-title face (global .page-title) */
      .name {
        margin: 0.5rem 0 0;
        font-size: clamp(2.1rem, 4vw, 2.8rem);
      }
      .pronounce {
        margin: 0.3rem 0 0.7rem;
        font: italic 400 0.98rem var(--font-display);
        letter-spacing: 0;
        color: rgb(var(--gray));
      }
      /* Roles in neutral grey; the place names are the links (site-wide link style) */
      .identity {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.3rem;
        font-size: 0.95rem;
        line-height: 1.45;
        color: rgba(var(--ink), 0.55);
      }
      .identity .sep {
        color: rgba(var(--ink), 0.3);
      }
      .identity a {
        white-space: nowrap; /* on a phone a place name moves to the next line whole */
      }
      .social {
        display: flex;
        gap: 18px;
        margin-top: 18px;
      }
      .icon-link {
        position: relative;
        color: #8c97a3;
        display: inline-flex;
        transition: color 0.2s ease, transform 0.2s ease;
      }
      .icon-link:hover {
        color: var(--blue);
        transform: translateY(-1px);
      }
      .tooltip {
        position: absolute;
        bottom: -24px;
        left: 50%;
        transform: translateX(-50%) translateY(6px);
        font-size: 11px;
        color: #7d8894;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: all 0.18s ease;
      }
      .icon-link:hover .tooltip {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
      @media (hover: none) {
        .tooltip {
          display: none;
        }
      }

      /* ===== Bio ===== */
      .bio {
        max-width: var(--col);
        margin: 2.2rem auto 0;
        font-size: 1.02rem;
        line-height: 1.75;
        color: rgba(var(--ink), 0.86);
      }
      .bio p {
        margin: 0 0 1.1rem;
      }
      /* .bio, .cv-note and .more links use the site-wide text-link style (global.css) */

      /* ===== Sections ===== */
      .block {
        max-width: var(--col);
        margin: 2.4rem auto 0;
      }
      .block h3 {
        font-size: 0.95rem;
        margin: 1.1rem 0 0.4rem;
        color: rgba(var(--ink), 0.7);
      }

      .cv {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.9rem;
      }
      .cv li {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: baseline;
      }
      .cv-main {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .cv-title {
        font-weight: 700;
        font-size: 0.98rem;
      }
      .cv-org {
        font-size: 0.92rem;
        color: rgba(var(--ink), 0.7);
      }
      .cv-note {
        font-size: 0.86rem;
        color: rgba(var(--ink), 0.6);
        line-height: 1.5;
      }
      .cv-dates {
        font-size: 0.84rem;
        color: rgb(var(--gray));
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }

      .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }
      .simple {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.55rem;
        font-size: 0.9rem;
      }
      .simple li {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        align-items: baseline;
      }

      .more {
        max-width: var(--col);
        margin: 2.4rem auto 0;
        font-size: 0.95rem;
      }
      .motto {
        margin: 2.4rem auto 0;
        text-align: center;
        font-family: "Source Han Serif SC", "Noto Serif SC", "Songti SC", serif;
        letter-spacing: 0.12em;
        opacity: 0.6;
      }

      @media (max-width: 720px) {
        .two-col {
          grid-template-columns: 1fr;
          gap: 1.4rem;
        }
        .cv li {
          grid-template-columns: 1fr;
          gap: 0.15rem;
        }
      }
    </style>
  </body>
</html>
