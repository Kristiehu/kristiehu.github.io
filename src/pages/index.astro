---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import ComplexType from "../components/ComplexType.astro";
import PointPortrait from "../components/PointPortrait.astro";
import DirectionCover from "../components/DirectionCover.astro";
import { DIRECTIONS } from "../data/directions";
import { getPosts } from "../lib/posts";

import { PROFILE } from "../data/profile";

// Work gallery: the three Lab directions (src/data/directions.ts), each opening its own list of projects.
const posts = await getPosts();
const gallery = DIRECTIONS.map((d) => ({ ...d, n: posts.filter((p) => p.data.direction === d.id).length }));

// Name and links come from src/data/profile.ts (shared with About).
const LINKS = [
  { label: "GitHub", href: PROFILE.links.github, external: true },
  { label: "LinkedIn", href: PROFILE.links.linkedin, external: true },
  { label: "Lab", href: PROFILE.links.lab, external: true },
  { label: "Email", href: PROFILE.links.email },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title='Home' description={SITE_DESCRIPTION} />

  </head>

  <body>
    <Header />

    <main class="wrap home">
      <div class="first">
      <!-- HERO (same as About) -->
      <section class="hero">
        <a class="portrait-link" href="#work" title="See my work">
          <PointPortrait width={140} />
        </a>

        <div class="heroText">
          <h1 class="page-title name">
            <span class="en">{PROFILE.name}</span>
            <span class="zh">{PROFILE.nameZh}</span>
            <span class="pronounce">{PROFILE.pronounce}</span>
          </h1>

          <div class="type">
            <ComplexType />
          </div>
          <p class="hero-quote-zh">
            不坠青云志，常怀赤子心。
          </p>

          <nav class="links" aria-label="Elsewhere">
            {LINKS.map((l) => (
              <a href={l.href} {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{l.label}</a>
            ))}
          </nav>

           
        </div>
      </section>
      

        <!-- FOOTER NOTE -->
      <section class="hero-quote">
        <p class="hero-quote">
          I’m driven by location intelligence, turning spatial complexity into clarity people can act on.
        </p>
      </section>

      <a class="scroll-cue" href="#work">Explore more<span class="arr down" aria-hidden="true">↓</span></a>
      </div>

      <!-- WORK GALLERY: three directions; each opens /blog/<direction>/ with all its projects -->
      <section id="work" class="work" aria-labelledby="work-title">
        <h2 id="work-title" class="page-title">What I work on</h2>
        <ol class="gallery">
          {gallery.map((d) => (
            <li class="g-item">
              <a class="g-cover" href={`/blog/${d.id}/`} aria-label={d.title}>
                <DirectionCover d={d} sizes="(max-width: 860px) 92vw, 340px" />
              </a>
              <h3><a href={`/blog/${d.id}/`}>{d.title}</a></h3>
              <p class="g-line">{d.line}</p>
              <a class="g-more" href={`/blog/${d.id}/`}>{d.n} {d.n === 1 ? "project" : "projects"}</a>
            </li>
          ))}
        </ol>
        <p class="all"><a href="/blog/">All my work<span class="arr" aria-hidden="true">→</span></a></p>
      </section>
    </main>

    <Footer />


    <style>

    .hero-quote{
      margin-top: clamp(6px, 1.6vw, 12px); 
      font-family: var(--font-display);
      font-style: italic;
      opacity: 0.62;
      line-height: 1.55;
      font-size: clamp(1.05rem, 1.6vw, 1.25rem);
      text-align: center;
    }
    

    .hero-quote-zh {
      margin-top: 0.45rem;
      font-size: clamp(1.05rem, 1.4vw, 1.2rem);
      letter-spacing: 0.12em;          
      line-height: 1.6;
      opacity: 0.78;

      font-family: var(--font-cjk-serif);
      font-weight: 400;
    }
    
    /* Name: the shared page-title face (global .page-title); Chinese name and pronunciation as on About */
    .name {
      margin: 0;
      font-size: clamp(2.1rem, 4vw, 2.8rem);
    }
    .pronounce {
      margin-left: 0.4rem;
      font: italic 400 0.98rem var(--font-display);
      letter-spacing: 0;
      color: rgb(var(--gray));
      vertical-align: middle;
    }

      .type {
        margin-top: 0.5rem;
        color: var(--blue);
      }

      .links { margin-top: 1.2rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
      .chip {
        position: relative;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
        font-size: 0.92rem;
        font-weight: 500;
        text-decoration: none;
        color: rgb(var(--black));
        border: 1px solid rgba(var(--ink),0.25);
        background: transparent;
        transition:
          background-color 160ms ease,
          color 160ms ease,
          border-color 160ms ease,
          transform 120ms ease;
        padding: 0.42rem 0.9rem;
        border-radius: 12px;          
        font-size: 0.92rem;
        font-weight: 500;

        border: 1px solid rgba(var(--ink), 0.25);
        background: transparent;
        color: rgb(var(--black));
      }

	    .chip:hover {
        background: rgba(var(--blue-rgb), 0.08);
        border-color: rgba(var(--blue-rgb), 0.25);
        transform: translateY(-3px);
      }


      .chip:active {
        transform: translateY(0);
      }

      .section { margin-top: 1rem; }

      .hero-divider{
        width: min(680px, 92%);
        height: 1px;
        margin: clamp(14px, 2.8vw, 22px) auto;
        background: rgba(var(--ink), 0.12);   
      }

      /* links as words, in the label face */
      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1.6rem;
        margin-top: 1.5rem;
      }
      .links a {
        padding: 0.2rem 0;
        font: 600 0.74rem / 1.4 var(--font-ui);
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: rgb(var(--gray));
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: color 0.16s ease, border-color 0.16s ease;
      }
      .links a:hover,
      .links a:focus-visible {
        color: var(--blue);
        border-bottom-color: rgba(var(--blue-rgb), 0.5);
      }




    /* ===== Layout: first screen (hero) + work gallery below ===== */
    .home {
      display: block;
      box-sizing: border-box;
      width: min(100%, 1100px);
      max-width: none;
    }
    .first {
      min-height: calc(100svh - 150px);
      display: grid;
      place-items: center;
      align-content: center;
      gap: 1rem;
    }
    /* The portrait turns a little toward the mouse (PointPortrait.astro) */
    .portrait-link {
      display: block;
      flex: none;
    }
    .scroll-cue {
      margin-top: clamp(1rem, 4vh, 2.5rem);
      font: 600 0.72rem var(--font-ui);
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: rgb(var(--gray));
      text-decoration: none;
    }
    .scroll-cue:hover {
      color: var(--blue);
    }
    :global(html) {
      scroll-behavior: smooth;
    }
    @media (prefers-reduced-motion: reduce) {
      :global(html) {
        scroll-behavior: auto;
      }
    }

    .work {
      padding: clamp(3rem, 9vh, 6rem) 0 1rem;
    }
    .gallery {
      list-style: none;
      margin: 2.4rem 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem 1.75rem;
    }
    .g-item {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    .g-cover {
      display: block;
    }
    .g-item h3 {
      margin: 1.1rem 0 0;
      font-size: 1.25rem;
      line-height: 1.25;
    }
    .g-item h3 a {
      color: rgb(var(--black));
      text-decoration: none;
    }
    .g-item h3 a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .g-line {
      margin: 0.4rem 0 0;
      font-size: 0.93rem;
      line-height: 1.55;
      color: rgba(var(--ink), 0.66);
    }
    .g-more {
      margin-top: 0.6rem;
      font-family: var(--font-ui);
      font-size: 0.9rem;
      color: var(--blue);
      text-decoration: none;
    }
    .g-more:hover,
    .all a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .all {
      margin: 2.6rem 0 0;
      font-family: var(--font-ui);
      text-align: center;
    }
    .all a {
      color: var(--blue);
      text-decoration: none;
    }
    @media (max-width: 860px) {
      .gallery {
        grid-template-columns: 1fr;
        gap: 2.6rem;
      }
    }

    </style>
  </body>
</html>
