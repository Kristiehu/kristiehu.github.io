---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import InlineLinks from "../components/InlineLinks.astro";
import { LEADERSHIP, TEACHING, COURSEWORK } from "../data/teaching";

// Content lives in src/data/teaching.ts; this page only lays it out.
const DESCRIPTION =
  "Kristie Hu's service, leadership and teaching: AAAI-27 Student Abstract and Poster Program committee, CE²GA Vice President, ISPRS STEP Ambassador, IEEE CSYPC 2026, and teaching assistant roles in geomatics and statistics.";

const sections = [
  { id: "service", label: "Leadership & Service", show: LEADERSHIP.length > 0 },
  { id: "teaching", label: "Teaching", show: TEACHING.length > 0 },
  { id: "coursework", label: "Coursework", show: COURSEWORK.length > 0 },
].filter((s) => s.show);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Teaching & Service" description={DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main class="page">
      <header class="page-head">
        <h1 class="page-title">Teaching &amp; Service</h1>
        <p class="lede">
          Outside research and work, I help run a graduate student association, take part in student leadership
          programs with ISPRS and IEEE, and support local community services. I’ve taught tutorials, labs and 
          lectures in geomatics, statistics and GIS, and I’m now completing the
          <a href="https://uwaterloo.ca/centre-for-teaching-excellence/support-graduate-students/fundamentals-university-teaching-program"
            target="_blank" rel="noopener noreferrer">Fundamentals of University Teaching program</a>
          at the University of Waterloo.
        </p>
        <nav class="jump" aria-label="On this page">
          {sections.map((s) => <a class="chip" href={`#${s.id}`}>{s.label}</a>)}
        </nav>
      </header>

      <!-- LEADERSHIP & SERVICE -->
      {
        LEADERSHIP.length > 0 && (
          <section id="service" class="section">
            <h2 class="section-title">Leadership &amp; Service</h2>
            <ol class="timeline">
              {LEADERSHIP.map((r) => (
                <li class="t-item">
                  <span class="t-dot" aria-hidden="true" />
                  <div class="t-card">
                    <div class="t-top">
                      <span class="t-role">{r.role}</span>
                      <span class="t-date">
                        {r.start}
                        {r.end ? ` – ${r.end}` : ""}
                      </span>
                    </div>
                    <div class="t-org"><InlineLinks text={r.org} /></div>
                    {r.points && r.points.length > 0 && (
                      <ul class="t-points">
                        {r.points.map((p) => (
                          <li><InlineLinks text={p} /></li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <!-- TEACHING -->
      {
        TEACHING.length > 0 && (
          <section id="teaching" class="section">
            <h2 class="section-title">Teaching</h2>
            <div class="inst-grid">
              {TEACHING.map((inst) => (
                <article class="panel">
                  <div class="panel-head">
                    <h3 class="panel-title">{inst.institution}</h3>
                    {inst.role && <span class="muted">{inst.role}</span>}
                  </div>
                  <ul class="course-list">
                    {inst.courses.map((c) => (
                      <li class="course-item">
                        <div class="course-main">
                          <span class="course-code">{c.code}</span>
                          <span class="course-name">{c.title}</span>
                        </div>
                        {((c.roles && c.roles.length > 0) || (c.tasks && c.tasks.length > 0) || (c.terms && c.terms.length > 0)) && (
                          <div class="course-meta">
                            {c.roles?.map((r) => (
                              <span class="badge role">{r}</span>
                            ))}
                            {c.tasks?.map((t) => (
                              <span class="badge task">{t}</span>
                            ))}
                            {c.terms && c.terms.length > 0 && <span class="badge term">{c.terms.join(" · ")}</span>}
                          </div>
                        )}
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <!-- COURSEWORK (hidden until src/data/teaching.ts has entries) -->
      {
        COURSEWORK.length > 0 && (
          <section id="coursework" class="section">
            <h2 class="section-title">Coursework</h2>
            <ul class="course-list panel">
              {COURSEWORK.map((c) => (
                <li class="course-item">
                  <div class="course-main">
                    <span class="course-code">{c.code}</span>
                    <span class="course-name">{c.title}</span>
                  </div>
                  {c.term && (
                    <div class="course-meta">
                      <span class="badge term">{c.term}</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>

    <Footer />

    <style>
      .page {
        box-sizing: border-box; /* the global main rule adds padding to a 100% width */
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 2.75rem 1.25rem 3.5rem;
      }

      .jump {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
      }
      .section {
        margin-top: 2.6rem;
      }

      /* ===== Timeline (Leadership & Service) ===== */
      .timeline {
        --axis-x: 12px;
        --dot: 10px;
        --col: 34px;
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .t-item {
        position: relative;
        display: grid;
        grid-template-columns: var(--col) 1fr;
        gap: 0.9rem;
        padding: 0.6rem 0;
      }
      .t-item::before {
        content: "";
        position: absolute;
        left: var(--axis-x);
        top: 0;
        bottom: 0;
        width: 2px;
        background: rgba(var(--ink), 0.08);
      }
      .t-item:first-child::before {
        top: 18px;
      }
      .t-item:last-child::before {
        bottom: calc(100% - 18px);
      }
      .t-dot {
        position: relative;
        width: var(--dot);
        height: var(--dot);
        margin-top: 1.05rem;
        left: calc(var(--axis-x) - (var(--dot) / 2) + 1px);
        border-radius: 999px;
        background: rgba(var(--blue-rgb), 0.85);
        box-shadow: 0 0 0 4px rgba(181, 85, 79, 0.12);
      }
      .t-card {
        padding: 0.85rem 1rem;
        border-radius: 14px;
        background: rgba(var(--ink), 0.03);
      }
      .t-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .t-role {
        font-weight: 700;
        font-size: 1rem;
      }
      .t-date {
        padding: 0.12rem 0.55rem;
        border-radius: 999px;
        font-size: 0.78rem;
        color: rgb(var(--gray));
        background: rgba(var(--blue-rgb), 0.08);
        white-space: nowrap;
      }
      .t-org {
        margin-top: 0.15rem;
        font-size: 0.92rem;
        color: rgba(var(--ink), 0.72);
      }
      .t-points {
        margin: 0.5rem 0 0;
        padding-left: 1.1rem;
        font-size: 0.88rem;
        line-height: 1.55;
        color: rgba(var(--ink), 0.75);
      }
      .t-points li + li {
        margin-top: 0.25rem;
      }

      /* ===== Teaching panels ===== */
      .inst-grid {
        display: grid;
        gap: 1rem;
      }
      .panel {
        padding: 1rem 1.05rem;
        border-radius: 16px;
        border: 1px solid rgba(var(--ink), 0.06);
        background: rgba(var(--ink), 0.02);
      }
      .panel-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
      }
      .panel-title {
        margin: 0;
        font-size: 1rem;
      }
      .muted {
        font-size: 0.85rem;
        opacity: 0.65;
      }
      .course-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.55rem;
      }
      .course-item {
        padding: 0.7rem 0.85rem;
        border-radius: 12px;
        background: rgba(var(--blue-rgb), 0.04);
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.75rem;
        align-items: center;
      }
      .course-main {
        min-width: 0;
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
        align-items: baseline;
      }
      .course-code {
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        font-weight: 800;
        font-size: 0.85rem;
        letter-spacing: -0.01em;
        background: rgba(var(--blue-rgb), 0.14);
        color: rgba(var(--blue-rgb), 0.95);
        white-space: nowrap;
      }
      .course-name {
        font-size: 0.95rem;
      }
      .course-meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.35rem;
      }
      .badge {
        display: inline-block;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        font-family: var(--font-ui);
        font-size: 0.76rem;
        white-space: nowrap;
      }
      .badge.role {
        background: rgba(var(--blue-rgb), 0.14);
        color: rgba(var(--blue-rgb), 0.95);
      }
      .badge.task {
        background: rgba(var(--ink), 0.05);
        color: rgba(var(--ink), 0.7);
      }
      .badge.term {
        background: rgba(var(--blue-rgb), 0.1);
        color: var(--blue);
      }

      @media (max-width: 720px) {
        .page {
          padding: 2.25rem 1rem 3rem;
        }
        .timeline {
          --axis-x: 10px;
          --col: 28px;
        }
        .course-item {
          grid-template-columns: 1fr;
        }
        .course-meta {
          justify-content: flex-start;
        }
      }
    </style>
  </body>
</html>
