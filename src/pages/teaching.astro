---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Teaching" description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main class="page">
      <section class="teaching-block">
        <h1 class="page-title">Teaching</h1>
        <p class="intro">
          I support geospatial and remote sensing teaching through
          <strong>guest lectures</strong>, <strong>labs</strong>,
          <strong>tutorials</strong>, and
          <strong>course material development</strong>—focused on practical
          workflows and clear delivery.
        </p>

        <!-- Timeline -->
        <ol class="timeline" aria-label="Teaching contributions timeline">
          <li class="t-item">
            <span class="t-dot" aria-hidden="true"></span>
            <div class="t-card">
              <div class="t-top">
                <span class="t-title">
                  <strong>Course Development &amp; Material</strong>
                </span>
                <span class="t-meta">Slides · Assignments · Labs</span>
              </div>
              <p class="t-desc">
                Drafted and refined lecture slides, lab exercises, and
                assignment instructions; improved clarity and reproducibility.
              </p>
            </div>
          </li>

          <li class="t-item">
            <span class="t-dot" aria-hidden="true"></span>
            <div class="t-card">
              <div class="t-top">
                <span class="t-title">
                  <strong>Laboratories &amp; Tutorials</strong>
                </span>
                <span class="t-meta">Small-group support</span>
              </div>
              <p class="t-desc">
                Led hands-on labs and tutorials, supported student workflows,
                and provided structured feedback on coursework.
              </p>
            </div>
          </li>

          <li class="t-item">
            <span class="t-dot" aria-hidden="true"></span>
            <div class="t-card">
              <div class="t-top">
                <span class="t-title">
                  <strong>Research-to-Classroom Bridging</strong>
                </span>
                <span class="t-meta">Methods → instruction</span>
              </div>
              <p class="t-desc">
                Helped align research methods with classroom teaching—turning
                complex concepts into teachable steps and demos.
              </p>
            </div>
          </li>
        </ol>

        <!-- Main appointment -->
        <h2 class="section-title">Main</h2>
        <div class="panel">
          <div class="panelTitle">
            University of Waterloo <span class="muted">[Full-time]</span>
          </div>

          <ul class="course-list">
            <li class="course-item">
              <div class="course-main">
                <span class="course-code">GEOG 101</span>
                <span class="course-name">Human Geography</span>
              </div>
              <div class="course-meta">
                <span class="badge role">TA</span>
                <span class="badge dur">1.0</span>
                <span class="badge task">Tutorial</span>
                <span class="badge task">Grading</span>
              </div>
            </li>

            <li class="course-item">
              <div class="course-main">
                <span class="course-code">GEOG 310</span>
                <span class="course-name">Geodesy &amp; Land Surveying</span>
              </div>
              <div class="course-meta">
                <span class="badge role">TA</span>
                <span class="badge role">Guest Lecture</span>
                <span class="badge dur">2.5</span>
                <span class="badge task">Lab</span>
                <span class="badge task">Tutorial</span>
                <span class="badge task">Materials</span>
                <span class="badge task">Grading</span>
              </div>
            </li>

            <li class="course-item">
              <div class="course-main">
                <span class="course-code">GEOG 316</span>
                <span class="course-name">Multivariate Statistics</span>
              </div>
              <div class="course-meta">
                <span class="badge role">TA</span>
                <span class="badge role">Guest Lecture</span>
                <span class="badge dur">1.0</span>
                <span class="badge task">Lab</span>
                <span class="badge task">Materials</span>
                <span class="badge task">Grading</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Other appointments -->
        <h2 class="section-title">Others</h2>
        <div class="panel">
          <div class="panelTitle">
            University of Toronto <span class="muted">[Part-time]</span>
          </div>

          <ul class="simple-list">
            <li>
              <span class="course-code">GGRA30H3</span>
              Geographic Information Systems and Empirical Reasoning
            </li>
            <li>
              <span class="course-code">MGEA06H3</span>
              Advanced Geographic Information Systems
            </li>
            <li>
              <span class="course-code">GGR210H5S</span>
              Social Geographies
            </li>
            <li>
              <span class="course-code">GGR209H5S</span>
              Economic Geography
            </li>
          </ul>
        </div>
      </section>
    </main>

    <Footer />

    <style>
      /* ============================================================
         Page container
         ============================================================ */
      .page {
        max-width: 980px;
        margin: 0 auto;
        padding: 2.75rem 1.25rem 3.5rem;
      }

      .teaching-block {
        margin-bottom: 2.5rem;
        width: 100%;
        box-sizing: border-box;
      }

      .page-title {
        margin: 0;
        font-size: 2rem;
        letter-spacing: -0.02em;
      }

      .intro {
        margin: 0.75rem 0 0;
        max-width: 72ch;
        line-height: 1.65;
        opacity: 0.9;
      }

      .section-title {
        margin: 2rem 0 1rem;
        font-size: 1.05rem;
        font-weight: 650;
        letter-spacing: -0.01em;
      }

      /* ============================================================
         Timeline
         ============================================================ */
      .timeline {
        --axis-x: 12px; /* vertical axis x-position */
        --dot: 10px;    /* dot size */
        --col: 34px;    /* left column width */

        list-style: none;
        padding: 0;
        margin: 0;
        width: 100%;
      }

      .t-item {
        position: relative;
        display: grid;
        grid-template-columns: var(--col) 1fr;
        gap: 0.9rem;
        padding: 0.95rem 0;
      }

      .t-item::before {
        content: "";
        position: absolute;
        left: var(--axis-x);
        top: 0;
        bottom: 0;
        width: 2px;
        background: rgba(0, 0, 0, 0.08);
      }

      .t-item:last-child::before {
        bottom: 18px;
      }

      .t-dot {
        position: relative;
        width: var(--dot);
        height: var(--dot);
        margin-top: 6px;
        left: calc(var(--axis-x) - (var(--dot) / 2));
        border-radius: 999px;
        background: rgba(181, 85, 79, 0.85);
        box-shadow: 0 0 0 4px rgba(181, 85, 79, 0.12);
      }

      .t-card {
        padding: 0.9rem 1rem;
        border-radius: 14px;
        background: rgba(0, 0, 0, 0.03);
      }

      .t-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .t-title {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.005em;
      }

      .t-desc {
        margin: 0.45rem 0 0;
        font-size: 0.95rem;
        line-height: 1.55;
        opacity: 0.85;
      }

      .t-meta {
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.8rem;
        color: #6b7280;
        background: rgba(181, 85, 79, 0.08);
      }

      /* ============================================================
         Panel + lists
         ============================================================ */
      .panel {
        width: 100%;
        padding: 1rem 1.05rem;
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        background: rgba(0, 0, 0, 0.02);
        box-sizing: border-box;
      }

      .panelTitle {
        margin-bottom: 0.75rem;
        font-weight: 650;
      }

      .muted {
        opacity: 0.65;
        font-weight: 500;
      }

      /* Simple list (Others panel) */
      .simple-list {
        list-style: none;
        padding: 0;
        margin: 0;
        width: 100%;
        display: grid;
        gap: 0.6rem;
      }

      .simple-list li {
        width: 100%;
        padding: 0.7rem 0.85rem;
        border-radius: 12px;
        background: rgba(181, 85, 79, 0.04);
        box-sizing: border-box;
        min-width: 0;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      /* Course list (Main panel) */
      .course-list {
        list-style: none;
        padding: 0;
        margin: 0;
        width: 100%;
        display: grid;
        gap: 0.6rem;
      }

      .course-item {
        width: 100%;
        padding: 0.8rem 0.9rem;
        border-radius: 12px;
        background: rgba(181, 85, 79, 0.04);
        box-sizing: border-box;

        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.75rem;
        align-items: start;
      }

      .course-main {
        min-width: 0;
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
        align-items: baseline;
      }

      .course-code {
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        font-weight: 800;
        letter-spacing: -0.02em;
        background: rgba(181, 85, 79, 0.14);
        color: rgba(181, 85, 79, 0.95);
      }

      .course-name {
        opacity: 0.9;
      }

      .course-meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.35rem;
        min-width: 0;
      }

      /* ============================================================
         Badges
         ============================================================ */
      .badge {
        display: inline-block;
        padding: 0.12rem 0.5rem;
        border-radius: 999px;
        font-size: 0.82rem;
        white-space: nowrap;
      }

      .badge.role {
        background: rgba(181, 85, 79, 0.14);
        color: rgba(181, 85, 79, 0.95);
      }

      .badge.dur {
        background: rgba(0, 0, 0, 0.07);
        color: rgba(0, 0, 0, 0.75);
      }

      .badge.task {
        background: rgba(0, 0, 0, 0.05);
        color: rgba(0, 0, 0, 0.7);
      }

      /* ============================================================
         Mobile
         ============================================================ */
      @media (max-width: 720px) {
        .page {
          padding: 2.25rem 1rem 3rem;
        }

        .page-title {
          font-size: 1.75rem;
        }

        .timeline {
          --axis-x: 10px;
          --col: 30px;
        }

        .t-top {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.15rem;
        }

        .t-meta {
          white-space: normal;
        }

        .course-item {
          grid-template-columns: 1fr;
        }

        .course-meta {
          justify-content: flex-start;
        }
      }
    </style>
  </body>
</html>
