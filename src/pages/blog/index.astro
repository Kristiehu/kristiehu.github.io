---
// Lab: every project as a card. Each card carries its main tag (one of three directions,
// `direction:` in the post's frontmatter); the chips filter by it via /blog/<direction>/.
// Posts without a direction are listed under "Earlier projects".
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import LabNav from '../../components/LabNav.astro';
import PostCard from '../../components/PostCard.astro';
import { DIRECTIONS } from '../../data/directions';
import { getPosts } from '../../lib/posts';

const posts = await getPosts(); // newest first; drafts only in `npm run dev`
const work = posts.filter((p) => p.data.direction);
const earlier = posts.filter((p) => !p.data.direction);
const counts = Object.fromEntries(DIRECTIONS.map((d) => [d.id, work.filter((p) => p.data.direction === d.id).length]));

const DESCRIPTION =
	'Kristie Hu’s projects and papers: LiDAR point clouds and 3D scenes, Earth-observation AI, and production spatial data systems.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Work" description={DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="lab">
			<header class="lab-head">
				<p class="kicker">Work</p>
				<h1 class="page-title">Projects, papers and tools</h1>
				<p class="lede">
					A collection of my research and applied work. Explore all projects below, or choose a research area to browse.
				</p>
				<LabNav counts={counts} />
			</header>

			<ul class="cards">
				{
					work.map((post) => (
						<li>
							<PostCard post={post} />
						</li>
					))
				}
			</ul>

			{
				earlier.length > 0 && (
					<section class="earlier" id="earlier">
						<h2 class="section-title">Earlier projects</h2>
						<ul>
							{earlier.map((p) => (
								<li>
									<a href={`/blog/${p.id}/`}>{p.data.short ?? p.data.title}</a>
									<span class="yr">{p.data.pubDate.getUTCFullYear()}</span>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />

		<style>
			.lab {
				box-sizing: border-box; /* the global main rule adds padding to a 100% width */
				width: min(100%, 1100px);
				max-width: none; /* global.css caps main at --container */
				padding: 2.75rem 1.25rem 3.5rem;
			}

			.lab-head .lede {
				margin-bottom: 1.3rem;
			}
			.cards {
				list-style: none;
				margin: 2rem 0 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.25rem;
			}

			.earlier {
				margin-top: 3.4rem;
				max-width: 44rem;
			}
			.earlier ul {
				list-style: none;
				margin: 0.9rem 0 0;
				padding: 0;
			}
			.earlier li {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 0.75rem;
				padding: 0.45rem 0;
				border-top: 1px solid rgba(var(--ink), 0.08);
				font-size: 0.9rem;
			}
			.earlier a {
				color: rgba(var(--ink), 0.7);
				text-decoration: none;
				overflow-wrap: normal;
			}
			.earlier a:hover {
				color: var(--blue);
				text-decoration: underline;
				text-underline-offset: 3px;
			}
			.yr {
				flex: none;
				font-size: 0.8rem;
				color: rgb(var(--gray));
				font-variant-numeric: tabular-nums;
			}

			@media (max-width: 720px) {
				.lab {
					padding: 2.25rem 1rem 3rem;
				}
			}
		</style>
	</body>
</html>
