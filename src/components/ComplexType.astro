<p class="typed">
  <span class="anchor">Ask me about </span>
  <span class="typed-slot">
    <span id="typed" class="typed-dynamic" aria-live="polite"></span>
    <span class="cursor" aria-hidden="true">▍</span>
  </span>
</p>


<style>
/* "Ask me about" in grey, the topic in blue (colour from .type on the homepage), both in the text serif.
   On phones the topic gets its own line, so a long topic is never cut off. */
.typed {
  margin: 0;
  line-height: 1.3;
  font-size: clamp(1.1rem, 1.7vw, 1.5rem);
  letter-spacing: -0.01em;
  text-align: left;
}

.anchor {
  font-family: inherit;
  font-weight: 400;
  color: rgb(var(--gray));
  letter-spacing: 0;
}

/* On wider screens the script reserves room for the longest topic, so the centred hero doesn't slide while typing */
.typed-slot {
  display: inline-block;
  text-align: left;
  white-space: nowrap;
}

.typed-dynamic {
  font-family: var(--font-text);
  font-weight: 500;
  letter-spacing: 0;
  padding: 0 0.14em;
  border-radius: 6px;
  background: linear-gradient(transparent 70%, rgba(var(--blue-rgb), 0.16) 0);
}

@media (max-width: 600px) {
  .anchor { display: block; }
  .typed-slot { white-space: normal; }
}

/* cursor */
.cursor {
  display: inline-block;
  opacity: 0.65;
  animation: blink 1.4s steps(1) infinite;
  transform: translateY(1px);
}

@keyframes blink { 50% { opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
  .cursor { animation: none; }
}
</style>

<script>
  const lines = [
  "GeoFMs.",
  "Urban Networks.",
  "Spatial ETL.",
  "EO Foundation Models.",
  "Urban Networks.",
  "Spatial Databases.",
  "LiDAR & 3D Mapping.",
  "Point Cloud Segmentation.",
  "2D–3D Fusion.",
  "Hyperspectral RS.",
  "Object Detection."
  ];

  const el = document.getElementById("typed");
  if (!el) throw new Error("TypedDescription: #typed not found");

  // Reserve room for the longest topic on wider screens (the hero is centred, so a growing line would make it slide).
  // On phones the topic sits on its own line and needs no reserve.
  const slot = el.parentElement;
  const cursor = slot.querySelector(".cursor");
  const reserve = () => {
    if (matchMedia("(max-width: 600px)").matches) { slot.style.minWidth = ""; return; }
    const probe = el.cloneNode();
    probe.removeAttribute("id");
    probe.removeAttribute("aria-live");
    probe.style.cssText = "position:absolute;visibility:hidden;white-space:nowrap";
    slot.appendChild(probe);
    let widest = 0;
    for (const t of lines) { probe.textContent = t; widest = Math.max(widest, probe.getBoundingClientRect().width); }
    probe.remove();
    slot.style.minWidth = Math.ceil(widest + (cursor ? cursor.getBoundingClientRect().width : 0)) + "px";
  };
  document.fonts.ready.then(reserve);
  addEventListener("resize", reserve);

  const TYPE_MS = 28;
  const ERASE_MS = 16;
  const PAUSE_MS = 1000;
  const GAP_MS = 250;

  let lineIdx = 0;
  let charIdx = 0;
  let mode = "typing";

  const tick = () => {
    const text = lines[lineIdx];

    if (mode === "typing") {
      charIdx++;
      el.textContent = text.slice(0, charIdx);
      if (charIdx >= text.length) {
        mode = "pausing";
        setTimeout(tick, PAUSE_MS);
        return;
      }
      setTimeout(tick, TYPE_MS);
      return;
    }

    if (mode === "pausing") {
      mode = "erasing";
      setTimeout(tick, ERASE_MS);
      return;
    }

    charIdx--;
    el.textContent = text.slice(0, Math.max(0, charIdx));

    if (charIdx <= 0) {
      mode = "typing";
      lineIdx = (lineIdx + 1) % lines.length;
      setTimeout(tick, GAP_MS);
      return;
    }

    setTimeout(tick, ERASE_MS);
  };

  tick();
</script>
