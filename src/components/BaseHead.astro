---
// Import global styles once, early
import '../styles/global.css';
// The site's one type family (see the type system in global.css): Source Serif 4 for text and titles,
// Source Sans 3 for navigation and labels, Source Code Pro for code. Self-hosted variable fonts.
import '@fontsource-variable/source-serif-4/opsz.css'; // upright, with optical sizes (titles get the display cut)
import '@fontsource-variable/source-serif-4/wght-italic.css'; // italic, only for the pronunciation and quotes
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/source-code-pro/wght.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// Props
const { title, description, image } = Astro.props as Props;

// Safe OG image:
// - If page passes an imported image (ImageMetadata), use it
// - Otherwise fall back to a stable public asset (no bundler import)
const ogUrl = image?.src
  ? new URL(image.src, Astro.url)
  : new URL('/og-new.png', Astro.site ?? Astro.url);

const pageTitle = title && title !== SITE_TITLE ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Theme: set before first paint so the page never flashes the wrong colours.
     A saved choice (the header button) wins; otherwise the site opens in the light theme. -->
<script is:inline>
  (() => {
    let theme = 'light';
    try {
      theme = localStorage.getItem('theme') || 'light';
    } catch (e) {}
    document.documentElement.dataset.theme = theme;
  })();
</script>


<!-- Author -->
<meta name="author" content="Kristie J. Hu" />

<!-- Google Search Console verification -->
<meta name="google-site-verification" content="JCcrqp27_OcS1fWLCACkc-3YKaMOD8LJgCCsOy2W170" />


<!-- Typography baseline (the font tokens live at the end of global.css) -->
<style>
  html {
    font-family: var(--font-text);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
</style>

<link rel="icon" type="image/svg+xml" href="/k.svg" />

<link rel="canonical" href={canonicalURL} />

<title>{pageTitle}</title>
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogUrl.toString()} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl.toString()} />

