---
// Post 16: open differences over 120 days, with and without the daily exchange.
// A simulation from a fixed seed, not real counts. About 20 new differences a day
// either way. Without a regular comparison only a few are resolved each day (3.5% of
// the open ones), so they build up; with the exchange, each day's batch is sent the
// same day and resolved within a few days.
const DAYS = 120;
const W = 640;
const H = 280;
const M = { top: 18, right: 112, bottom: 34, left: 46 };

function rng(seed: number) {
	return () => {
		seed |= 0;
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}
const rand = rng(16);
const arrivals = Array.from({ length: DAYS }, () => Math.round(20 + (rand() - 0.5) * 12));

const without: number[] = [];
let open = 0;
for (const a of arrivals) {
	open += a;
	open -= Math.round(open * 0.035);
	without.push(open);
}
const withCheck = arrivals.map((a, d) => a + Math.round((arrivals[d - 1] ?? 0) * 0.5) + Math.round((arrivals[d - 2] ?? 0) * 0.15));

const yMax = Math.ceil(Math.max(...without) / 100) * 100;
const x = (d: number) => M.left + (d / (DAYS - 1)) * (W - M.left - M.right);
const y = (v: number) => H - M.bottom - (v / yMax) * (H - M.top - M.bottom);
const line = (s: number[]) => s.map((v, d) => `${d ? "L" : "M"}${x(d).toFixed(1)} ${y(v).toFixed(1)}`).join("");
const yTicks = Array.from({ length: yMax / 100 + 1 }, (_, i) => i * 100);
const xTicks = [0, 30, 60, 90, 119];
const last = DAYS - 1;
---

<figure class="bl" data-without={JSON.stringify(without)} data-with={JSON.stringify(withCheck)}>
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Simulated open differences over 120 days: without a regular comparison they build up; with the daily exchange they stay low.">
		{yTicks.map((t) => (
			<g>
				<line class="grid" x1={M.left} x2={W - M.right} y1={y(t)} y2={y(t)} />
				<text class="tick" x={M.left - 8} y={y(t)} text-anchor="end" dominant-baseline="middle">{t}</text>
			</g>
		))}
		{xTicks.map((d) => (
			<text class="tick" x={x(d)} y={H - M.bottom + 18} text-anchor="middle">day {d + 1}</text>
		))}
		<path class="l-without" d={line(without)} />
		<path class="l-with" d={line(withCheck)} />
		<text class="end end-without" x={x(last) + 8} y={y(without[last])} dominant-baseline="middle">
			<tspan x={x(last) + 8} dy="-0.6em">No regular</tspan>
			<tspan x={x(last) + 8} dy="1.2em">comparison</tspan>
		</text>
		<text class="end end-with" x={x(last) + 8} y={y(withCheck[last])} dominant-baseline="middle">Daily exchange</text>
		<line class="hover" x1="0" x2="0" y1={M.top} y2={H - M.bottom} visibility="hidden" />
		<rect class="catch" x={M.left} y={M.top} width={W - M.left - M.right} height={H - M.top - M.bottom} />
	</svg>
	<p class="readout" aria-live="polite">Hover or tap the chart to read a day.</p>
	<figcaption>Simulated: about 20 new differences a day in both cases. It shows the pattern, not real counts.</figcaption>
</figure>

<script>
	document.querySelectorAll<HTMLElement>(".bl[data-without]").forEach((root) => {
		const without: number[] = JSON.parse(root.dataset.without ?? "[]");
		const withCheck: number[] = JSON.parse(root.dataset.with ?? "[]");
		const svg = root.querySelector("svg");
		const catcher = root.querySelector<SVGRectElement>(".catch");
		const hover = root.querySelector<SVGLineElement>(".hover");
		const readout = root.querySelector(".readout");
		if (!svg || !catcher || !hover || !readout) return;

		function at(clientX: number) {
			const box = catcher!.getBoundingClientRect();
			const f = Math.min(1, Math.max(0, (clientX - box.left) / box.width));
			const d = Math.round(f * (without.length - 1));
			const xv = Number(catcher!.getAttribute("x")) + f * Number(catcher!.getAttribute("width"));
			hover!.setAttribute("x1", String(xv));
			hover!.setAttribute("x2", String(xv));
			hover!.setAttribute("visibility", "visible");
			readout!.textContent = `Day ${d + 1}: ${without[d]} open without a regular comparison, ${withCheck[d]} with the daily exchange.`;
		}

		catcher.addEventListener("pointermove", (e) => at(e.clientX));
		catcher.addEventListener("pointerdown", (e) => at(e.clientX));
	});
</script>

<style>
	.bl {
		margin: 0;
		padding: 1rem 1.1rem 0.9rem;
		border: 1px solid rgba(var(--ink), 0.13);
		border-radius: 6px;
		background: rgb(var(--paper));
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		touch-action: pan-y;
	}
	.grid {
		stroke: rgba(var(--ink), 0.09);
	}
	.tick {
		font: 0.7rem var(--font-ui);
		fill: rgba(var(--ink), 0.5);
	}
	.l-without,
	.l-with {
		fill: none;
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.l-without {
		stroke: rgb(216, 58, 31);
	}
	.l-with {
		stroke: var(--blue);
	}
	.end {
		font: 600 0.74rem var(--font-ui);
	}
	.end-without {
		fill: rgb(216, 58, 31);
	}
	.end-with {
		fill: var(--blue);
	}
	.hover {
		stroke: rgba(var(--ink), 0.35);
		stroke-dasharray: 3 3;
	}
	.catch {
		fill: transparent;
		cursor: crosshair;
	}
	.readout {
		margin: 0.5rem 0 0;
		font: 0.82rem var(--font-ui);
		color: rgba(var(--ink), 0.72);
		min-height: 1.3em;
	}
	figcaption {
		margin-top: 0.4rem;
		font: 0.72rem var(--font-ui);
		color: rgba(var(--ink), 0.5);
	}
</style>
