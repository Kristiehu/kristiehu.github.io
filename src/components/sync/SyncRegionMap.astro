---
// Post 16: the four regions the hand-off covers, with a simulated week of differences
// for each. The outline is drawn at build time (no map tiles, nothing loaded from other
// sites); the dots mark each region as a whole, not any real equipment or route.
import { geoConicConformal, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import countries50 from "world-atlas/countries-50m.json";

const W = 640;
const H = 300;

const shapes = (feature(countries50 as any, (countries50 as any).objects.countries) as any).features;
const canada = shapes.find((f: any) => String(f.id) === "124");
const usa = shapes.find((f: any) => String(f.id) === "840");

const projection = geoConicConformal()
	.parallels([44, 52])
	.rotate([96, 0])
	.fitExtent([[12, 12], [W - 12, H - 12]], {
		type: "MultiPoint",
		coordinates: [[-127, 48], [-66, 47], [-125, 54], [-68, 52], [-96, 41.5], [-96, 56]],
	} as any)
	.clipExtent([[0, 0], [W, H]]);
const path = geoPath(projection).digits(1);

// Simulated week, fixed seed: about 20 differences a day across all four regions.
function rng(seed: number) {
	return () => {
		seed |= 0;
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}
const rand = rng(42);
const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

const REGIONS = [
	{ id: "van", name: "Vancouver", lon: -123.12, lat: 49.28, share: 0.18, dx: 18, dy: 5, anchor: "start" },
	{ id: "gta", name: "Greater Toronto Area", lon: -79.38, lat: 43.7, share: 0.45, dx: -6, dy: 38, anchor: "middle" },
	{ id: "ott", name: "Ottawa", lon: -75.7, lat: 45.42, share: 0.12, dx: -14, dy: -18, anchor: "end" },
	{ id: "mtl", name: "Montreal", lon: -73.57, lat: 45.5, share: 0.25, dx: 20, dy: 5, anchor: "start" },
].map((r) => {
	const days = DAYS.map(() => {
		const n = Math.max(1, Math.round((20 + (rand() - 0.5) * 8) * r.share + (rand() - 0.5) * 2));
		const id = Math.round(n * (0.12 + rand() * 0.16)); // entry errors: the smaller share
		return { id, status: n - id };
	});
	const [x, y] = projection([r.lon, r.lat]) as [number, number];
	return { ...r, x, y, days, total: days.reduce((s, d) => s + d.id + d.status, 0) };
});

const maxTotal = Math.max(...REGIONS.map((r) => r.total));
const maxDay = Math.max(...REGIONS.flatMap((r) => r.days.map((d) => d.id + d.status)));
const radius = (t: number) => 7 + 11 * Math.sqrt(t / maxTotal);
const first = REGIONS.find((r) => r.id === "gta")!;
const pct = (v: number) => `${((v / maxDay) * 100).toFixed(1)}%`;
const DATA = Object.fromEntries(REGIONS.map((r) => [r.id, { name: r.name, total: r.total, days: r.days }]));
---

<figure class="rm" data-regions={JSON.stringify(DATA)} data-max={maxDay}>
	<div class="pick" role="group" aria-label="Region">
		{REGIONS.map((r) => (
			<button type="button" data-r={r.id} aria-pressed={r.id === first.id ? "true" : "false"}>{r.name}</button>
		))}
	</div>

	<div class="body">
		<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Outline of southern Canada with the four regions marked: Vancouver, the Greater Toronto Area, Ottawa and Montreal.">
			<path class="usa" d={path(usa) ?? ""} />
			<path class="can" d={path(canada) ?? ""} />
			{REGIONS.map((r) => (
				<g class:list={["reg", { on: r.id === first.id }]} data-r={r.id}>
					<circle class="halo" cx={r.x} cy={r.y} r={radius(r.total) + 5} />
					<circle class="dot" cx={r.x} cy={r.y} r={radius(r.total)} />
					<text x={r.x + r.dx} y={r.y + r.dy} text-anchor={r.anchor}>{r.name}</text>
				</g>
			))}
		</svg>

		<div class="panel">
			<p class="name">{first.name}</p>
			<p class="total"><b>{first.total}</b> differences this week</p>
			<div class="bars" aria-hidden="true">
				{first.days.map((d, i) => (
					<div class="col">
						<div class="stack">
							<span class="s-status" style={`height:${pct(d.status)}`}></span>
							<span class="s-id" style={`height:${pct(d.id)}`}></span>
						</div>
						<span class="day">{DAYS[i]}</span>
					</div>
				))}
			</div>
			<p class="legend">
				<span><i class="k-status"></i>Status not in sync</span>
				<span><i class="k-id"></i>Entry error</span>
			</p>
		</div>
	</div>
	<figcaption>Simulated week, about 20 differences a day across all four regions. Dots mark whole regions, not equipment or routes.</figcaption>
</figure>

<script>
	type Day = { id: number; status: number };
	type Region = { name: string; total: number; days: Day[] };

	document.querySelectorAll<HTMLElement>(".rm[data-regions]").forEach((root) => {
		const regions: Record<string, Region> = JSON.parse(root.dataset.regions ?? "{}");
		const max = Number(root.dataset.max) || 1;
		const pct = (v: number) => `${((v / max) * 100).toFixed(1)}%`;
		const buttons = root.querySelectorAll<HTMLButtonElement>(".pick button");
		const marks = root.querySelectorAll<SVGGElement>(".reg");

		function show(id: string) {
			const r = regions[id];
			if (!r) return;
			buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.r === id)));
			marks.forEach((m) => m.classList.toggle("on", m.dataset.r === id));
			const name = root.querySelector(".name");
			const total = root.querySelector(".total b");
			if (name) name.textContent = r.name;
			if (total) total.textContent = String(r.total);
			root.querySelectorAll<HTMLElement>(".col").forEach((col, i) => {
				const d = r.days[i];
				const s = col.querySelector<HTMLElement>(".s-status");
				const k = col.querySelector<HTMLElement>(".s-id");
				if (d && s) s.style.height = pct(d.status);
				if (d && k) k.style.height = pct(d.id);
			});
		}

		buttons.forEach((b) => b.addEventListener("click", () => show(b.dataset.r ?? "")));
		marks.forEach((m) => m.addEventListener("click", () => show(m.dataset.r ?? "")));
	});
</script>

<style>
	.rm {
		margin: 0;
		padding: 1rem 1.1rem 0.9rem;
		border: 1px solid rgba(var(--ink), 0.13);
		border-radius: 6px;
		background: rgb(var(--paper));
	}
	.pick {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.pick button {
		font: 500 0.8rem var(--font-ui);
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
		border: 1px solid rgba(var(--ink), 0.2);
		background: transparent;
		color: rgba(var(--ink), 0.72);
		cursor: pointer;
	}
	.pick button[aria-pressed="true"] {
		color: var(--blue);
		border-color: var(--blue);
		background: rgba(var(--blue-rgb), 0.08);
	}
	.body {
		display: grid;
		grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
		margin-top: 0.8rem;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.usa {
		fill: rgba(var(--ink), 0.035);
		stroke: rgba(var(--ink), 0.12);
		stroke-width: 0.6;
	}
	.can {
		fill: rgba(var(--ink), 0.09);
		stroke: rgba(var(--ink), 0.22);
		stroke-width: 0.6;
	}
	.reg {
		cursor: pointer;
	}
	.reg .dot {
		fill: rgba(var(--blue-rgb), 0.45);
		stroke: var(--blue);
		stroke-width: 1.2;
		transition: fill 0.2s ease;
	}
	.reg .halo {
		fill: none;
		stroke: var(--blue);
		stroke-width: 1.5;
		opacity: 0;
	}
	.reg.on .dot {
		fill: var(--blue);
	}
	.reg.on .halo {
		opacity: 0.6;
		transform-box: fill-box;
		transform-origin: center;
		animation: pulse 2.4s ease-out infinite;
	}
	@keyframes pulse {
		0% {
			transform: scale(0.8);
			opacity: 0.7;
		}
		100% {
			transform: scale(1.5);
			opacity: 0;
		}
	}
	.reg text {
		font: 600 16px var(--font-ui);
		fill: rgb(var(--black));
		paint-order: stroke;
		stroke: rgb(var(--paper));
		stroke-width: 3px;
		stroke-linejoin: round;
	}
	.panel p {
		margin: 0;
	}
	.name {
		font: 600 1rem var(--font-text);
	}
	.total {
		font: 0.85rem var(--font-ui);
		color: rgba(var(--ink), 0.65);
	}
	.total b {
		font-size: 1.35rem;
		color: rgb(var(--black));
		margin-right: 0.2rem;
	}
	.bars {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 0.3rem;
		height: 7.5rem;
		margin-top: 0.6rem;
	}
	.col {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		min-height: 0;
	}
	.stack {
		flex: 1;
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}
	.stack span {
		display: block;
		width: 100%;
		transition: height 0.3s ease;
	}
	.s-status {
		background: var(--blue);
		border-radius: 3px 3px 0 0;
	}
	.s-id {
		background: rgb(216, 58, 31);
	}
	.day {
		font: 0.66rem var(--font-ui);
		color: rgba(var(--ink), 0.5);
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.9rem;
		margin-top: 0.6rem !important;
		font: 0.74rem var(--font-ui);
		color: rgba(var(--ink), 0.65);
	}
	.legend span {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.legend i {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 2px;
	}
	.k-id {
		background: rgb(216, 58, 31);
	}
	.k-status {
		background: var(--blue);
	}
	figcaption {
		margin-top: 0.6rem;
		font: 0.72rem var(--font-ui);
		color: rgba(var(--ink), 0.5);
	}
	@media (max-width: 640px) {
		.body {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.reg.on .halo {
			animation: none;
		}
		.stack span {
			transition: none;
		}
	}
</style>
