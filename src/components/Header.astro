---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { Moon, Sun } from 'lucide-astro';
---

<header class="site-header">
  <nav class="nav">
    <div class="brand">
      <a href="/">{SITE_TITLE}</a>
    </div>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu">
      <span class="menu-icon" aria-hidden="true"></span>
      <span class="menu-text">Menu</span>
    </button>


    <div class="internal-links" id="site-menu">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Work</HeaderLink>
      <HeaderLink href="/teaching">Community</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>

    <button class="theme-toggle" type="button" aria-label="Switch between light and dark theme" title="Light / dark">
      <span class="icon-moon" aria-hidden="true"><Moon size={18} /></span>
      <span class="icon-sun" aria-hidden="true"><Sun size={18} /></span>
    </button>

  </nav>
  <div class="menu-scrim" aria-hidden="true"></div>
</header>


<script>
  const header = document.querySelector('.site-header');
const btn = header?.querySelector('.menu-btn');
const menu = header?.querySelector('#site-menu');

  // While the menu is open, <html> gets .menu-open: the page behind is dimmed and can't scroll.
  function closeMenu() {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', 'false');
    menu.classList.remove('is-open');
    document.documentElement.classList.remove('menu-open');
  }

  function toggleMenu() {
    if (!btn || !menu) return;
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu.classList.toggle('is-open', !open);
    document.documentElement.classList.toggle('menu-open', !open);
  }

  if (btn && menu) {
    closeMenu(); 

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
    document.addEventListener('click', closeMenu);
    document.addEventListener('astro:page-load', closeMenu);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
    window.addEventListener('pageshow', closeMenu);
    window.addEventListener('resize', () => {
      if (window.innerWidth > 720) closeMenu();
    });
  }
  
</script>



<style>
  /* Desktop default */
.menu-btn { display: none; }

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--header-bg);
  border-bottom: 1px solid rgba(var(--ink),0.06);
}

/* Desktop links: a thin blue line grows in under a link on hover (half strength) and stays under the current page */
@media (min-width: 721px) {
  .internal-links :global(a) {
    position: relative;
    padding: 0.55rem 0.1rem;
    color: rgb(var(--gray-dark));
    opacity: 0.72;
    text-decoration: none;
    transition: opacity 160ms ease, color 160ms ease;
  }
  .internal-links :global(a)::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 2px;
    border-radius: 2px;
    background: var(--blue);
    transform: scaleX(0);
    transition: transform 220ms var(--hover-ease), opacity 160ms ease;
  }
  .internal-links :global(a:hover),
  .internal-links :global(a:focus-visible),
  .internal-links :global(a.active) {
    opacity: 1;
    color: rgb(var(--black));
  }
  .internal-links :global(a:hover)::after,
  .internal-links :global(a:focus-visible)::after {
    transform: scaleX(1);
    opacity: 0.5;
  }
  .internal-links :global(a.active)::after {
    transform: scaleX(1);
    opacity: 1;
  }
  .internal-links :global(a:focus-visible) {
    outline: 2px solid rgba(var(--blue-rgb), 0.6);
    outline-offset: 4px;
    border-radius: 4px;
  }
}
@media (min-width: 721px) and (prefers-reduced-motion: reduce) {
  .internal-links :global(a)::after {
    transition: none;
  }
}

.nav {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0.75rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand a {
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  text-decoration: none;
  color: rgb(var(--black));
  transition: color 160ms ease;
}
.brand a:hover {
  color: var(--blue);
}

.internal-links {
  display: flex;
  gap: 1.25rem;
  font-size: 0.9rem;
}

.internal-links a {
  text-decoration: none;
}



.menu-scrim { display: none; }

/* Mobile */
@media (max-width: 720px) {
  :root{
    /* 雾蓝体系：低饱和、偏灰蓝 */
    --mist-blue: rgba(var(--blue-rgb), 0.90);      /* 主色 */
    --mist-blue-weak: rgba(var(--blue-rgb), 0.12); /* hover bg */
    --mist-blue-soft: rgba(var(--blue-rgb), 0.18); /* active bg */
    --mist-ink: rgba(17, 24, 39, 0.82);        /* 深色文字 */
    --mist-border: rgba(var(--blue-rgb), 0.18);    /* 边框 */
    --mist-shadow: 0 18px 50px rgba(17, 24, 39, 0.14);
  }

  .nav { position: static; } /* the open menu is positioned against the sticky header */

  /* ===== MENU BUTTON ===== */
  .menu-btn{
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    position: relative;
    z-index: 10001;
    padding: 0.50rem 0.85rem;
    border-radius: 999px;

    background: rgba(240, 246, 255, 0.78); /* 雾蓝玻璃 */
    border: 1px solid var(--mist-border);
    color: var(--mist-ink);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;

    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }

  .menu-btn:hover{
    background: rgba(240, 246, 255, 0.90);
    border-color: rgba(var(--blue-rgb), 0.26);
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(17, 24, 39, 0.10);
  }

  .menu-btn:active{
    transform: translateY(0);
  }

  .menu-btn:focus-visible{
    outline: none;
    box-shadow: 0 0 0 4px rgba(var(--blue-rgb), 0.18);
  }

  /* ===== HAMBURGER → X (using aria-expanded) ===== */
  .menu-icon{
    width: 18px;
    height: 12px;
    position: relative;
    display: inline-block;
  }

  .menu-icon::before,
  .menu-icon::after{
    content:"";
    position:absolute;
    left:0; right:0;
    height:2px;
    background: var(--mist-blue);
    border-radius: 999px;
    transition: transform 180ms ease, top 180ms ease, bottom 180ms ease, opacity 180ms ease;
  }

  .menu-icon::before{ top:0; }
  .menu-icon::after{ bottom:0; }

  /* Middle line */
  .menu-icon span{
    display:none;
  }

  /* When open: turn into X */
  .menu-btn[aria-expanded="true"] .menu-icon::before{
    top: 5px;
    transform: rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] .menu-icon::after{
    bottom: 5px;
    transform: rotate(-45deg);
  }

  /* Default closed */
  .internal-links{ display: none; }

  /* ===== DROPDOWN ===== */
  /* A solid sheet that hangs from the bottom edge of the header, full width, in the header's own colour,
     so the two read as one layer. The rest of the page is dimmed by .menu-scrim and can't scroll. */
  .internal-links.is-open{
    display: flex;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    flex-direction: column;
    gap: 0.15rem;

    box-sizing: border-box;
    padding: 0.35rem 1rem 0.95rem;

    background: var(--header-bg);
    border-radius: 0 0 22px 22px;
    box-shadow: 0 16px 30px rgba(17, 24, 39, 0.1);
    z-index: 2;
    overscroll-behavior: contain;

    animation: sheetIn 160ms ease-out;
  }

  @keyframes sheetIn{
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* The dimmed page under the open menu; tapping it closes the menu (document click) */
  :global(html.menu-open) .menu-scrim{
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 100vh;
    z-index: 1;
    background: rgba(10, 12, 16, 0.32);
    touch-action: none;
    animation: scrimIn 160ms ease-out;
  }

  @keyframes scrimIn{
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  :global(html.menu-open){
    overflow: hidden; /* on <html> only: locking <body> as well would break the sticky header */
  }

  @media (prefers-reduced-motion: reduce){
    .internal-links.is-open,
    :global(html.menu-open) .menu-scrim{
      animation: none;
    }
  }

  .internal-links.is-open a{
    position: relative;
    display: flex;
    align-items: center;

    width: 100%;
    box-sizing: border-box;
    padding: 0.8rem 0.95rem 0.8rem 1.1rem;
    font-size: 1.02rem;

    border-radius: 12px;
    text-decoration: none;

    color: rgba(17, 24, 39, 0.82);
    font-weight: 600;
    letter-spacing: 0.01em;

    transition: background 140ms ease, color 140ms ease;
  }

  .internal-links.is-open a:hover{
    background: var(--mist-blue-weak);
    color: rgba(17, 24, 39, 0.92);
  }

  /* Active / current page: 雾蓝高亮条 */
  .internal-links.is-open a.active,
  .internal-links.is-open a[aria-current="page"]{
    background: var(--mist-blue-soft);
  }

  .internal-links.is-open a.active::before,
  .internal-links.is-open a[aria-current="page"]::before{
    content:"";
    position:absolute;
    left: 10px;
    top: 10px;
    bottom: 10px;
    width: 3px;
    border-radius: 999px;
    background: rgba(var(--blue-rgb), 0.92);
  }

  /* Kill desktop underline style in mobile menu */
  .internal-links a{
    border-bottom: none !important;
  }

}



</style>

<script>
  // Light / dark toggle. The first paint is handled by the inline script in BaseHead.astro.
  const themeBtn = document.querySelector('.theme-toggle');
  themeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (err) {}
  });
</script>

<style>
  /* ===== Light / dark toggle ===== */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 36px;
    height: 36px;
    margin-left: 1rem;
    padding: 0;
    border-radius: 999px;
    border: 1px solid rgba(var(--ink), 0.12);
    background: transparent;
    color: rgb(var(--gray-dark));
    cursor: pointer;
    transition: background 140ms ease, border-color 140ms ease;
  }
  .theme-toggle:hover {
    background: rgba(var(--ink), 0.06);
    border-color: rgba(var(--ink), 0.22);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
  .icon-moon {
    display: inline-flex;
  }
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: inline-flex;
  }

  @media (min-width: 721px) {
    .nav {
      justify-content: flex-start;
    }
    .internal-links {
      margin-left: auto;
    }
  }
  @media (max-width: 720px) {
    .theme-toggle {
      order: 2;
      margin-left: auto;
    }
    .menu-btn {
      order: 3;
      margin-left: 0.5rem;
    }
  }

  /* ===== Dark theme: header and mobile menu ===== */
  :global(:root[data-theme='dark']) .site-header {
    border-bottom-color: rgba(var(--ink), 0.07);
  }
  :global(:root[data-theme='dark']) .menu-btn {
    background: rgba(20, 24, 32, 0.85);
    border-color: rgba(var(--blue-rgb), 0.3);
    color: rgba(238, 236, 230, 0.9);
  }
  :global(:root[data-theme='dark']) .menu-icon::before,
  :global(:root[data-theme='dark']) .menu-icon::after {
    background: var(--blue);
  }
  :global(:root[data-theme='dark']) .internal-links.is-open {
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06), 0 18px 34px rgba(0, 0, 0, 0.5);
  }
  :global(:root[data-theme='dark'].menu-open) .menu-scrim {
    background: rgba(0, 0, 0, 0.55);
  }
  :global(:root[data-theme='dark']) .internal-links.is-open a {
    color: rgba(238, 236, 230, 0.86);
  }
  :global(:root[data-theme='dark']) .internal-links.is-open a:hover {
    background: rgba(var(--blue-rgb), 0.16);
    color: rgba(238, 236, 230, 0.96);
  }
</style>
